# ─────────────────────────────────────────────────────────────
#  SafeStep / هم‌قدم — نمونه‌ی متغیرهای محیطی
#  این فایل را به .env کپی کنید:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- سرور ---
NODE_ENV=development
PORT=4000
# مبدأهای مجاز برای CORS (با کاما جدا شوند)
CORS_ORIGINS=http://localhost:4000,http://localhost:5173,http://127.0.0.1:4000

# --- دیتابیس ---
# دو درایور پشتیبانی می‌شود:
#   pg     → PostgreSQL واقعی (حالت docker compose) — نیازمند DATABASE_URL
#   pglite → همان PostgreSQL کامپایل‌شده به WASM، درون‌پردازه‌ای، بدون هیچ پیش‌نیازی
# اگر DB_DRIVER تعیین نشود و DATABASE_URL هم موجود نباشد، خودکار روی pglite می‌افتد.
DB_DRIVER=pglite
DATABASE_URL=postgres://safestep:safestep@localhost:5432/safestep
# مسیر ذخیره‌ی داده در حالت pglite (نسبت به backend/)
PGLITE_DATA_DIR=./.pglite

# --- امنیت ---
# ⚠️ در محیط تولید حتماً مقادیر تصادفی و بلند بگذارید:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# کلید HMAC برای هش کردن کدهای دعوت (جدا از JWT نگه داشته شود)
INVITE_CODE_PEPPER=dev-only-invite-pepper-change-me-in-production
BCRYPT_ROUNDS=10

# --- محدودسازی نرخ درخواست ---
RATE_LIMIT_AUTH_MAX=10          # حداکثر تلاش ورود/ثبت‌نام در هر پنجره
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_SOS_MAX=3            # حداکثر SOS در هر پنجره
RATE_LIMIT_SOS_WINDOW_MS=60000
RATE_LIMIT_INVITE_MAX=20
RATE_LIMIT_INVITE_WINDOW_MS=900000

# --- موتور Geofence ---
GEOFENCE_HYSTERESIS_M=25        # آستانه‌ی خروج = R + این مقدار، بازگشت = R − این مقدار
GEOFENCE_DEBOUNCE_COUNT=2       # تعداد پینگ متوالی لازم برای تأیید تغییر وضعیت
GEOFENCE_COOLDOWN_SEC=60        # حداقل فاصله بین دو هشدار هم‌نوع برای یک محدوده

# --- تشخیص توقف طولانی ---
STOP_DETECT_DEFAULT_MINUTES=20
STOP_DETECT_DEFAULT_RADIUS_M=40
STOP_DETECT_MIN_PINGS=4

# --- تشخیص قطع GPS ---
GPS_LOST_AFTER_SEC=180

# --- نوتیفیکیشن ---
# اگر FCM_SERVER_KEY خالی باشد، آداپتور خودکار روی WebSocket + لاگ درون‌برنامه‌ای می‌افتد.
# با گذاشتن کلید، بدون هیچ تغییر کدی ارسال واقعی فعال می‌شود.
NOTIFICATION_DRIVER=auto        # auto | fcm | local
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# --- شبیه‌ساز موقعیت (حالت نمایش) ---
DEMO_MODE=true                  # اگر false شود، تمام endpointهای /simulator غیرفعال می‌شوند
SIMULATOR_TICK_MS=1500          # فاصله‌ی زمانی بین پینگ‌های شبیه‌سازی‌شده

# --- داده‌ی نمونه ---
SEED_DEFAULT_PASSWORD=Test@1234
